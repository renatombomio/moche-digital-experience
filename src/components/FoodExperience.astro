---
const staffImages = [
  "/images/staff/chef.jpg",
  "/images/staff/kitchen.jpg",
  "/images/staff/service.jpg",
  "/images/staff/team.jpg",
];

const dishes = [
  {
    image: "/images/food/01-ceviche-moche.jpg",
    alt: "Ceviche Moche",
    name: "Ceviche Moche",
    description:
      "Kingfish, prawns, ají amarillo, Andean cancha and leche de tigre.",
    details:
      "A Moche interpretation of one of Peru's most iconic dishes, combining fresh kingfish and prawns with ají amarillo, Andean cancha and leche de tigre.",
    ingredients: [
      "Kingfish",
      "Prawns",
      "Ají amarillo",
      "Andean cancha",
      "Leche de tigre",
    ],
    allergens: [],
  },
  {
    image: "/images/food/02-tiradito-scallops.jpg",
    alt: "Tiradito de scallops",
    name: "Tiradito Scallops",
    description:
      "Scallops, avocado, cucumber, salsa chalaca and ají limo oil.",
    details:
      "Delicate scallops paired with fresh avocado, cucumber, salsa chalaca and aromatic ají limo oil.",
    ingredients: [
      "Scallops",
      "Avocado",
      "Cucumber",
      "Salsa chalaca",
      "Ají limo",
    ],
    allergens: [],
  },
  {
    image: "/images/food/03-lomo-saltado.jpg",
    alt: "Lomo Saltado",
    name: "Lomo Saltado",
    description:
      "Tenderloin, Nikkei oyster sauce, crispy potatoes and Peruvian rice.",
    details:
      "A Peruvian classic with Nikkei influence, bringing together tenderloin, oyster sauce, crispy potatoes and Peruvian rice.",
    ingredients: [
      "Tenderloin",
      "Oyster sauce",
      "Potatoes",
      "Peruvian rice",
    ],
    allergens: [],
  },
  {
    image: "/images/food/04-chargrilled-octopus.jpg",
    alt: "Chargrilled octopus",
    name: "Chargrilled Octopus",
    description:
      "Chargrilled octopus, anticuchera sauce, acevichada mayo and herbs.",
    details:
      "Chargrilled octopus finished with Peruvian anticuchera flavours, acevichada mayo and fresh herbs.",
    ingredients: [
      "Octopus",
      "Anticuchera sauce",
      "Acevichada mayo",
      "Fresh herbs",
    ],
    allergens: [],
  },
  {
    image: "/images/food/05-coulant-dulce-de-leche.jpg",
    alt: "Dulce de leche coulant",
    name: "Dulce de Leche",
    description:
      "Warm coulant, hazelnut crumble and Peruvian coffee ice cream.",
    details:
      "A warm dessert combining dulce de leche with hazelnut crumble and Peruvian coffee ice cream.",
    ingredients: [
      "Dulce de leche",
      "Hazelnut",
      "Peruvian coffee",
      "Ice cream",
    ],
    allergens: [],
  },
];
---

<section
  class="food-experience"
  aria-label="Moche food experience"
  data-dishes={JSON.stringify(dishes)}
>

  <!-- =========================================
       STAFF BACKGROUND
  ========================================= -->

  <div
    class="food-experience__background"
    aria-hidden="true"
  >
    {staffImages.map((src, index) => (
      <img
        class:list={[
          "food-experience__background-image",
          { "is-active": index === 0 },
        ]}
        src={src}
        alt=""
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
      />
    ))}
  </div>

  <div
    class="food-experience__overlay"
    aria-hidden="true"
  ></div>


  <!-- =========================================
       ANCIENT PERU → MODERN CUISINE
  ========================================= -->

  <div class="food-experience__intro">

    <div class="food-experience__intro-stage">

      <div
        class="
          food-experience__message
          food-experience__message--from
        "
      >
        <span class="food-experience__eyebrow">
          Moche
        </span>

        <h2>
          From Ancient<br />
          Peru
        </h2>
      </div>


      <div
        class="food-experience__motif"
        aria-hidden="true"
      >
        <svg
          class="moche-motif"
          viewBox="0 0 300 300"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            class="motif-line"
            d="M150 18 L282 94 L282 206 L150 282 L18 206 L18 94 Z"
          />

          <path
            class="motif-line"
            d="M150 58 L242 111 L242 189 L150 242 L58 189 L58 111 Z"
          />

          <path
            class="motif-line"
            d="M150 92 L208 126 L208 174 L150 208 L92 174 L92 126 Z"
          />

          <path
            class="motif-line"
            d="M150 18 L150 92 M150 208 L150 282"
          />

          <path
            class="motif-line"
            d="M18 150 L92 150 M208 150 L282 150"
          />

          <path
            class="motif-line motif-line--accent"
            d="M150 128 L172 150 L150 172 L128 150 Z"
          />
        </svg>
      </div>


      <div
        class="
          food-experience__message
          food-experience__message--modern
        "
      >
        <span class="food-experience__eyebrow">
          Moche
        </span>

        <h2>
          To Modern<br />
          Cuisine
        </h2>
      </div>

    </div>
  </div>


  <!-- =========================================
       FOOD CAROUSEL
  ========================================= -->

  <div class="food-experience__menu">

    <div
      class="food-carousel"
      aria-label="Moche signature dishes"
    >

      <div class="food-carousel__track">

        {dishes.map((dish, index) => (
          <article
            class:list={[
              "food-card",
              { "is-current": index === 0 },
            ]}
            data-dish={index}
          >

            <button
              class="food-card__button"
              type="button"
              aria-label={`View details for ${dish.name}`}
            >

              <div class="food-card__image">

                <img
                  src={dish.image}
                  alt={dish.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />

              </div>


              <div class="food-card__content">

                <span class="food-card__eyebrow">
                  Moche
                </span>

                <h3>
                  {dish.name}
                </h3>

                <p>
                  {dish.description}
                </p>

                <span class="food-card__discover">
                  Discover dish
                  <span aria-hidden="true">↗</span>
                </span>

              </div>

            </button>

          </article>
        ))}

      </div>

    </div>


    <!-- =========================================
         PROGRESS
    ========================================= -->

    <div class="food-experience__progress">

      <span></span>

    </div>


    <!-- =========================================
         FULL MENU
    ========================================= -->

    <div class="food-experience__full-menu">

      <p>
        Want to explore more?
      </p>

      <button
        class="food-experience__menu-button"
        type="button"
      >
        <span>
          View full menu
        </span>

        <span aria-hidden="true">
          →
        </span>
      </button>

    </div>

  </div>


  <!-- =========================================
       DISH MODAL
  ========================================= -->

  <div
    class="dish-modal"
    aria-hidden="true"
  >

    <div
      class="dish-modal__backdrop"
      data-modal-close
    ></div>


    <div
      class="dish-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dish-modal-title"
    >

      <button
        class="dish-modal__close"
        type="button"
        aria-label="Close dish details"
        data-modal-close
      >
        ×
      </button>


      <div class="dish-modal__image">

        <img
          src=""
          alt=""
          data-modal-image
        />

      </div>


      <div class="dish-modal__content">

        <span
          class="dish-modal__eyebrow"
          data-modal-eyebrow
        >
          Moche
        </span>

        <h2
          id="dish-modal-title"
          data-modal-title
        ></h2>

        <p
          class="dish-modal__description"
          data-modal-description
        ></p>


        <div class="dish-modal__section">

          <h3>
            Ingredients
          </h3>

          <ul
            data-modal-ingredients
          ></ul>

        </div>


        <div class="dish-modal__section">

          <h3>
            Allergens
          </h3>

          <p
            data-modal-allergens
          >
            Allergen information available on request.
          </p>

        </div>

      </div>

    </div>

  </div>

</section>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const foodSection =
  document.querySelector<HTMLElement>(
    ".food-experience"
  );

const dishesData =
  foodSection?.dataset.dishes;

const dishes =
  dishesData
    ? JSON.parse(dishesData)
    : [];


  /* =========================================
     ELEMENTS
  ========================================= */

  const section =
    document.querySelector(
      ".food-experience"
    );

  const intro =
    document.querySelector(
      ".food-experience__intro"
    );

  const fromMessage =
    document.querySelector(
      ".food-experience__message--from"
    );

  const modernMessage =
    document.querySelector(
      ".food-experience__message--modern"
    );

  const motif =
    document.querySelector(
      ".food-experience__motif"
    );

  const paths =
    document.querySelectorAll<SVGPathElement>(
      ".motif-line"
    );

  const backgroundImages =
    Array.from(
      document.querySelectorAll<HTMLImageElement>(
        ".food-experience__background-image"
      )
    );

  const carouselTrack =
  document.querySelector<HTMLElement>(
    ".food-carousel__track"
  );

  const cards =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        ".food-card"
      )
    );

  const progress =
    document.querySelector(
      ".food-experience__progress span"
    );

  const modal =
    document.querySelector(
      ".dish-modal"
    );

  const modalImage =
    document.querySelector<HTMLImageElement>(
      "[data-modal-image]"
    );

  const modalTitle =
    document.querySelector(
      "[data-modal-title]"
    );

  const modalDescription =
    document.querySelector(
      "[data-modal-description]"
    );

  const modalIngredients =
    document.querySelector(
      "[data-modal-ingredients]"
    );

  const modalAllergens =
    document.querySelector(
      "[data-modal-allergens]"
    );

  const modalCloseButtons =
    document.querySelectorAll(
      "[data-modal-close]"
    );

  const fullMenuButton =
    document.querySelector(
      ".food-experience__menu-button"
    );

  const reduceMotion =
    window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;


  /* =========================================
     STAFF BACKGROUND
  ========================================= */

  let currentBackground = 0;

  const changeBackground = () => {

    if (
      backgroundImages.length < 2
    ) {
      return;
    }

    backgroundImages[
      currentBackground
    ].classList.remove(
      "is-active"
    );

    currentBackground =
      (
        currentBackground + 1
      ) %
      backgroundImages.length;

    backgroundImages[
      currentBackground
    ].classList.add(
      "is-active"
    );
  };


  window.setInterval(
    changeBackground,
    4500
  );


  /* =========================================
     ANCIENT PERU → MODERN CUISINE
  ========================================= */

  if (
    intro &&
    fromMessage &&
    modernMessage &&
    motif &&
    paths.length &&
    !reduceMotion
  ) {

    paths.forEach((path) => {

      const length =
        path.getTotalLength();

      gsap.set(path, {
        strokeDasharray: length,
        strokeDashoffset: length,
      });

    });


    gsap.set(
      modernMessage,
      {
        opacity: 0,
        y: 35,
      }
    );


    gsap.set(
      motif,
      {
        opacity: 0.25,
        scale: 0.72,
      }
    );


    const introTimeline =
      gsap.timeline({
        scrollTrigger: {
          trigger: intro,
          start: "top 85%",
          end: "bottom 35%",
          scrub: 1.4,
          invalidateOnRefresh: true,
        },
      });


    introTimeline
      .to(motif, {
        opacity: 1,
        scale: 1,
        duration: 0.25,
        ease: "power2.out",
      })

      .to(
        paths,
        {
          strokeDashoffset: 0,
          duration: 0.5,
          stagger: 0.045,
          ease: "none",
        },
        "<"
      )

      .to(
        fromMessage,
        {
          opacity: 0,
          y: -45,
          duration: 0.2,
          ease: "power2.inOut",
        }
      )

      .to(
        motif,
        {
          scale: 1.08,
          rotation: 3,
          duration: 0.2,
          ease: "power2.inOut",
        },
        "<"
      )

      .to(
        modernMessage,
        {
          opacity: 1,
          y: 0,
          duration: 0.28,
          ease: "power2.out",
        }
      )

      .to(
        motif,
        {
          scale: 0.88,
          rotation: -2,
          opacity: 0.42,
          duration: 0.25,
          ease: "power2.inOut",
        },
        "<"
      );
  }


  /* =========================================
     CAROUSEL STATE
  ========================================= */

  let currentCard = 0;


  /* =========================================
     GSAP CARD TRANSITIONS
  ========================================= */

  const animateCards = () => {

    if (!carouselTrack) {
      return;
    }


    const trackCenter =
      carouselTrack.scrollLeft +
      carouselTrack.clientWidth / 2;


    cards.forEach(
      (card, index) => {

        const cardCenter =
          card.offsetLeft +
          card.offsetWidth / 2;

        const distance =
          cardCenter -
          trackCenter;

        const normalized =
          Math.max(
            -1,
            Math.min(
              1,
              distance /
                carouselTrack.clientWidth
            )
          );


        const abs =
          Math.abs(normalized);


        const scale =
          1 -
          abs * 0.08;

        const opacity =
          1 -
          abs * 0.38;

        const rotation =
          normalized * -2.5;

        const imageScale =
          1 +
          abs * 0.045;


        gsap.set(
          card,
          {
            scale,
            opacity,
            rotationY: rotation,
            transformOrigin: "center center",
          }
        );


        const image =
          card.querySelector(
            ".food-card__image img"
          );

        const content =
          card.querySelector(
            ".food-card__content"
          );


        if (image) {

          gsap.set(
            image,
            {
              scale: imageScale,
              x: normalized * -18,
            }
          );

        }


        if (content) {

          gsap.set(
            content,
            {
              x: normalized * 14,
            }
          );

        }


        card.classList.toggle(
          "is-current",
          index === currentCard
        );

      }
    );
  };


  /* =========================================
     FIND CURRENT CARD
  ========================================= */

  const updateCurrentCard =
    () => {

      if (!carouselTrack) {
        return;
      }


      const trackCenter =
        carouselTrack.scrollLeft +
        carouselTrack.clientWidth / 2;


      let closestIndex = 0;

      let closestDistance =
        Infinity;


      cards.forEach(
        (card, index) => {

          const cardCenter =
            card.offsetLeft +
            card.offsetWidth / 2;

          const distance =
            Math.abs(
              cardCenter -
              trackCenter
            );


          if (
            distance <
            closestDistance
          ) {

            closestDistance =
              distance;

            closestIndex =
              index;

          }

        }
      );


      currentCard =
        closestIndex;


      updateProgress();
  };


  /* =========================================
     PROGRESS
  ========================================= */

  const updateProgress =
    () => {

      if (!progress) {
        return;
      }


      const percentage =
        cards.length <= 1
          ? 100
          : (
              currentCard /
              (cards.length - 1)
            ) *
            100;


      gsap.to(
        progress,
        {
          width: `${percentage}%`,
          duration: 0.35,
          ease: "power2.out",
        }
      );

    };


  /* =========================================
     SNAP TO CARD
  ========================================= */

  let scrollTimeout: number | undefined;


  const snapToNearestCard =
    () => {

      if (
        !carouselTrack ||
        !cards.length
      ) {
        return;
      }


      const card =
        cards[currentCard];

      if (!card) {
        return;
      }


      const target =
        card.offsetLeft -
        (
          carouselTrack.clientWidth -
          card.offsetWidth
        ) /
          2;


      if (reduceMotion) {

        carouselTrack.scrollLeft =
          target;

      } else {

        gsap.to(
          carouselTrack,
          {
            scrollLeft: target,
            duration: 0.65,
            ease:
              "power3.out",
            onUpdate:
              animateCards,
          }
        );

      }

    };


  /* =========================================
     NATIVE SCROLL / SWIPE
  ========================================= */

  carouselTrack?.addEventListener(
    "scroll",
    () => {

      animateCards();

      updateCurrentCard();


      window.clearTimeout(
        scrollTimeout
      );


      scrollTimeout =
        window.setTimeout(
          snapToNearestCard,
          120
        );

    },
    {
      passive: true,
    }
  );


  /* =========================================
     DESKTOP WHEEL → HORIZONTAL CAROUSEL
  ========================================= */

  carouselTrack?.addEventListener(
  "wheel",
  (event: WheelEvent) => {

      if (
        window.innerWidth < 768
      ) {
        return;
      }


      if (
        Math.abs(event.deltaY) <=
        Math.abs(event.deltaX)
      ) {
        return;
      }


      const maxScroll =
        carouselTrack.scrollWidth -
        carouselTrack.clientWidth;


      const atStart =
        carouselTrack.scrollLeft <= 0;

      const atEnd =
        carouselTrack.scrollLeft >=
        maxScroll - 1;


      if (
        (event.deltaY < 0 && atStart) ||
        (event.deltaY > 0 && atEnd)
      ) {
        return;
      }


      event.preventDefault();


      carouselTrack.scrollBy({
        left:
          event.deltaY * 1.25,
        behavior: "auto",
      });

    },
    {
      passive: false,
    }
  );


  /* =========================================
     INITIAL STATE
  ========================================= */

  requestAnimationFrame(
    () => {

      updateProgress();

      animateCards();

    }
  );


  /* =========================================
     DISH MODAL
  ========================================= */

  const openDishModal =
    (index: number) => {

      const dish =
        dishes[index];

      if (
        !dish ||
        !modal ||
        !modalImage ||
        !modalTitle ||
        !modalDescription ||
        !modalIngredients ||
        !modalAllergens
      ) {
        return;
      }


      modalImage.src =
        dish.image;

      modalImage.alt =
        dish.alt;

      modalTitle.textContent =
        dish.name;

      modalDescription.textContent =
        dish.details;


      modalIngredients.innerHTML =
        dish.ingredients
          .map(
            (ingredient: any) =>
              `<li>${ingredient}</li>`
          )
          .join("");


      modalAllergens.textContent =
        dish.allergens.length
          ? dish.allergens.join(", ")
          : "Allergen information available on request.";


      modal.classList.add(
        "is-open"
      );

      modal.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.classList.add(
        "modal-open"
      );


      if (!reduceMotion) {

        gsap.fromTo(
          ".dish-modal__dialog",
          {
            opacity: 0,
            y: 40,
            scale: 0.97,
          },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.45,
            ease:
              "power3.out",
          }
        );

      }

    };


  const closeDishModal =
    () => {

      if (!modal) {
        return;
      }


      if (!reduceMotion) {

        gsap.to(
          ".dish-modal__dialog",
          {
            opacity: 0,
            y: 25,
            scale: 0.98,
            duration: 0.2,
            ease:
              "power2.in",
            onComplete: () => {

              modal.classList.remove(
                "is-open"
              );

              modal.setAttribute(
                "aria-hidden",
                "true"
              );

              document.body.classList.remove(
                "modal-open"
              );

            },
          }
        );

      } else {

        modal.classList.remove(
          "is-open"
        );

        modal.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.classList.remove(
          "modal-open"
        );

      }

    };


  cards.forEach(
    (card, index) => {

      const button =
        card.querySelector(
          ".food-card__button"
        );


      button?.addEventListener(
        "click",
        () => {

          openDishModal(
            index
          );

        }
      );

    }
  );


  modalCloseButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        closeDishModal
      );

    }
  );


  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key === "Escape"
      ) {

        closeDishModal();

      }

    }
  );


  /* =========================================
     FULL MENU
  ========================================= */

  fullMenuButton?.addEventListener(
    "click",
    () => {

      window.dispatchEvent(
        new CustomEvent(
          "moche:open-menu"
        )
      );

    }
  );
</script>


<style>

  /* =========================================
     EXPERIENCE
  ========================================= */

  .food-experience {

    --moche-gold: #c49a4d;
    --moche-cream: #f5f2ea;

    position: relative;

    overflow: hidden;

    background: #080808;

    color:
      var(--moche-cream);
  }


  /* =========================================
     BACKGROUND
  ========================================= */

  .food-experience__background {

    position: absolute;

    inset: -8%;

    z-index: 0;

    opacity: 0.72;

    transform: scale(1.04);

    filter:
      grayscale(1)
      blur(7px)
      contrast(0.9);

    pointer-events: none;
  }


  .food-experience__background-image {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    object-fit: cover;

    opacity: 0;

    transform: scale(1.04);

    transition:
      opacity 1.8s ease,
      transform 6s ease;
  }


  .food-experience__background-image.is-active {

    opacity: 1;

    transform: scale(1);
  }


  /* =========================================
     OVERLAY
  ========================================= */

  .food-experience__overlay {

    position: absolute;

    inset: 0;

    z-index: 1;

    background:
      linear-gradient(
        to bottom,
        rgba(5, 5, 5, 0.42) 0%,
        rgba(5, 5, 5, 0.25) 35%,
        rgba(5, 5, 5, 0.28) 65%,
        rgba(5, 5, 5, 0.48) 100%
      );

    pointer-events: none;
  }


  /* =========================================
     INTRO — COMPACT DESKTOP
  ========================================= */

  .food-experience__intro {

    position: relative;

    z-index: 2;

    min-height: 27svh;

    overflow: hidden;
  }


  .food-experience__intro-stage {

    position: relative;

    min-height: 27svh;

    display: flex;

    align-items: center;

    justify-content: center;
  }


  .food-experience__message {

    position: absolute;

    inset: 0;

    z-index: 4;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    padding: 1.5rem;

    text-align: center;

