---
const slides = [
  {
    src: "/images/hero/food.jpg",
    alt: "Moche Peruvian cuisine",
  },
  {
    src: "/images/hero/craft.jpg",
    alt: "Moche kitchen and culinary craft",
  },
  {
    src: "/images/hero/pisco.jpg",
    alt: "Pisco cocktail at Moche",
  },
  {
    src: "/images/hero/experience.jpg",
    alt: "Moche restaurant experience",
  },
];
---

<section class="hero" aria-label="Moche introduction">
  <div class="hero__images" aria-hidden="true">
    {slides.map((slide, index) => (
      <img
        class:list={["hero__image", { "is-active": index === 0 }]}
        src={slide.src}
        alt=""
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
      />
    ))}
  </div>

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__statement">
      <h1>Moche</h1>

      <p>Peruvian Cuisine &amp; Pisco Bar</p>
    </div>

    <a class="hero__cta" href="/booking">
      <span>Book a table</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span>Scroll</span>
    <span class="hero__scroll-line"></span>
  </div>
</section>

<script>
  const images = Array.from(
    document.querySelectorAll<HTMLImageElement>(".hero__image")
  );

  let currentIndex = 0;

  const changeSlide = () => {
    if (images.length < 2) return;

    images[currentIndex].classList.remove("is-active");

    currentIndex = (currentIndex + 1) % images.length;

    images[currentIndex].classList.add("is-active");
  };

  window.setInterval(changeSlide, 5000);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-dark);
    color: var(--color-white);
  }

  .hero__images {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 1.2s ease,
      transform 7s ease;
  }

  .hero__image.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.34) 0%,
        rgba(0, 0, 0, 0.05) 35%,
        rgba(0, 0, 0, 0.08) 55%,
        rgba(0, 0, 0, 0.58) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    padding:
     6rem
  var(--mobile-gutter)
  5rem;
  }

  .hero__statement {
    margin-bottom: 1.5rem;
  }

  .hero__statement h1 {
    margin: 0;
    font-size: clamp(4.5rem, 22vw, 8rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.07em;
  }

  .hero__statement p {
    max-width: 17rem;
    margin: 1.5rem 0 0;
    font-size: 0.85rem;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 56px;
    padding: 0 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .hero__cta span:last-child {
    font-size: 1.2rem;
    line-height: 1;
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    background: var(--color-white);
    color: var(--color-dark);
  }

  .hero__scroll {
    position: absolute;
    right: var(--mobile-gutter);
    bottom: 2rem;
    z-index: 3;
    display: none;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 2.5rem;
    margin-top: 0.5rem;
    background: currentColor;
  }

  @media (min-width: 768px) {
    .hero__content {
      padding:
        8rem
        3rem
        3rem;
    }

    .hero__statement h1 {
      font-size: clamp(7rem, 18vw, 13rem);
    }

    .hero__statement p {
      font-size: 0.9rem;
    }

    .hero__cta {
      width: fit-content;
      min-width: 220px;
      gap: 3rem;
    }

    .hero__scroll {
      display: block;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      transition: opacity 300ms ease;
      transform: none;
    }

    .hero__image.is-active {
      transform: none;
    }
  }
</style>