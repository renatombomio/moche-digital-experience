---
const slides = [
  {
    src: "/images/hero/food.jpg",
  },
  {
    src: "/images/hero/craft.jpg",
  },
  {
    src: "/images/hero/pisco.jpg",
  },
  {
    src: "/images/hero/experience.jpg",
  },
];
---

<section class="hero" aria-labelledby="hero-title">

  <div class="hero__media" aria-hidden="true">
    {slides.map((slide, index) => (
      <img
        class:list={["hero__image", { "is-active": index === 0 }]}
        src={slide.src}
        alt=""
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={index === 0 ? "high" : "auto"}
      />
    ))}
  </div>

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__transition" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__statement">
      <h1 id="hero-title">Moche</h1>
      <p>
        Peruvian cuisine &amp; pisco
        <span>in Amsterdam</span>
      </p>
    </div>

    <a
      class="hero__cta"
      href="https://www.thefork.com/restaurant/moche-peruvian-cuisine-pisco-bar-r810879"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Book a table at Moche on TheFork"
    >
      <span class="hero__cta-label">
        Book a table
      </span>

      <span
        class="hero__cta-arrow"
        aria-hidden="true"
      >
        →
      </span>
    </a>
  </div>

  <div
    class="hero__scroll"
    aria-hidden="true"
  >
    <span class="hero__scroll-label">
      Scroll
    </span>
    <span class="hero__scroll-line"></span>
  </div>

</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>(".hero");
  const images = Array.from(document.querySelectorAll<HTMLImageElement>(".hero__image"));
  const content = document.querySelector<HTMLElement>(".hero__content");
  const transition = document.querySelector<HTMLElement>(".hero__transition");
  const scrollIndicator = document.querySelector<HTMLElement>(".hero__scroll");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let currentIndex = 0;
  let slideshowTimer: number | undefined;

  const showSlide = (nextIndex: number) => {
    if (images.length < 2) return;

    images[currentIndex].classList.remove("is-active");
    currentIndex = nextIndex;
    images[currentIndex].classList.add("is-active");
  };

  const nextSlide = () => {
    showSlide((currentIndex + 1) % images.length);
  };

  const startSlideshow = () => {
    if (images.length < 2 || reduceMotion.matches || document.hidden) {
      return;
    }

    if (slideshowTimer !== undefined) {
      window.clearInterval(slideshowTimer);
    }

    slideshowTimer = window.setInterval(nextSlide, 6000);
  };

  const stopSlideshow = () => {
    if (slideshowTimer !== undefined) {
      window.clearInterval(slideshowTimer);
      slideshowTimer = undefined;
    }
  };

  const handleVisibilityChange = () => {
    if (document.hidden) {
      stopSlideshow();
    } else {
      startSlideshow();
    }
  };

  document.addEventListener("visibilitychange", handleVisibilityChange);

  reduceMotion.addEventListener("change", () => {
    if (reduceMotion.matches) {
      stopSlideshow();
    } else {
      startSlideshow();
    }
  });

  startSlideshow();

  if (
    hero &&
    content &&
    transition &&
    scrollIndicator &&
    !reduceMotion.matches
  ) {
    const heroTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: hero,
        start: "bottom 82%",
        end: "bottom 15%",
        scrub: 1.4,
        invalidateOnRefresh: true,
      },
    });

    heroTimeline.to(content, {
      opacity: 0,
      y: -32,
      ease: "none",
      duration: 0.45,
    }, 0);

    heroTimeline.to(scrollIndicator, {
      opacity: 0,
      ease: "none",
      duration: 0.2,
    }, 0);

    heroTimeline.to(transition, {
      opacity: 1,
      ease: "none",
      duration: 0.75,
    }, 0.2);
  }

  document.addEventListener(
    "astro:before-swap",
    () => {
      stopSlideshow();
      document.removeEventListener("visibilitychange", handleVisibilityChange);
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    },
    { once: true }
  );
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-dark);
    color: var(--color-white);
    isolation: isolate;
  }

  .hero__media { position: absolute; inset: 0; z-index: 0; }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.035);
    transition: opacity 1400ms cubic-bezier(.22,1,.36,1), transform 8000ms cubic-bezier(.22,1,.36,1);
    will-change: opacity, transform;
  }

  .hero__image.is-active { opacity: 1; transform: scale(1); }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(0,0,0,.38) 0%, rgba(0,0,0,.06) 38%, rgba(0,0,0,.12) 62%, rgba(0,0,0,.62) 100%);
    pointer-events: none;
  }

  .hero__transition {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,.08) 45%, rgba(0,0,0,.55) 78%, rgba(0,0,0,1) 100%);
    pointer-events: none;
    will-change: opacity;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 7rem var(--mobile-gutter) 5rem;
    text-align: center;
    will-change: opacity, transform;
  }

  .hero__statement {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .hero__statement h1 {
    margin: 0;
    font-size: clamp(5.25rem, 19vw, 11rem);
    font-weight: 500;
    line-height: .82;
    letter-spacing: -.065em;
    text-transform: none;
    font-family: var(--font-display);
  }

  .hero__statement p {
    max-width: 20rem;
    margin: 1.75rem 0 0;
    font-size: .72rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .hero__statement p span { display: block; }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: fit-content;
    min-width: 190px;
    min-height: 52px;
    padding: 0 1rem;
    border: 1px solid rgba(255,255,255,.72);
    color: var(--color-white);
    font-size: .7rem;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
    transition: background-color 350ms cubic-bezier(.22,1,.36,1), color 350ms cubic-bezier(.22,1,.36,1), border-color 350ms cubic-bezier(.22,1,.36,1);
    backdrop-filter: blur(5px);
  }

  .hero__cta-arrow {
    margin-left: 2.5rem;
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 350ms cubic-bezier(.22,1,.36,1);
  }

  .hero__cta:hover {
    background: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-dark);
  }

  .hero__cta:hover .hero__cta-arrow { transform: translateX(4px); }

  .hero__cta:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 5px;
  }

  .hero__scroll {
    position: absolute;
    right: var(--mobile-gutter);
    bottom: 2rem;
    z-index: 4;
    display: none;
    align-items: center;
    flex-direction: column;
    color: var(--color-white);
    will-change: opacity;
  }

  .hero__scroll-label { font-size: .62rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .hero__scroll-line { display: block; width: 1px; height: 2.75rem; margin-top: .65rem; background: currentColor; transform-origin: top; }

  @media (min-width: 768px) {
    .hero__content { padding: 8rem 3rem 4rem; }
    .hero__statement h1 { font-size: clamp(8rem,17vw,13rem); }
    .hero__statement p { max-width: none; font-size: .78rem; }
    .hero__statement p span { display: inline; }
    .hero__cta { min-width: 205px; min-height: 54px; }
    .hero__scroll { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image { transform: none; transition: opacity 300ms ease; }
    .hero__image.is-active { transform: none; }
    .hero__transition { opacity: 0; }
    .hero__content { transform: none; }
    .hero__cta, .hero__cta-arrow { transition: none; }
  }
</style>