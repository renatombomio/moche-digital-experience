---
const slides = [
  {
    src: "/images/hero/food.jpg",
    alt: "Moche Peruvian cuisine",
  },
  {
    src: "/images/hero/craft.jpg",
    alt: "Moche kitchen and culinary craft",
  },
  {
    src: "/images/hero/pisco.jpg",
    alt: "Pisco cocktail at Moche",
  },
  {
    src: "/images/hero/experience.jpg",
    alt: "Moche restaurant experience",
  },
];
---

<section class="hero" aria-label="Moche introduction">

  <div class="hero__images" aria-hidden="true">
    {slides.map((slide, index) => (
      <img
        class:list={[
          "hero__image",
          { "is-active": index === 0 },
        ]}
        src={slide.src}
        alt=""
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
      />
    ))}
  </div>


  <!-- Permanent image contrast -->
  <div
    class="hero__overlay"
    aria-hidden="true"
  ></div>


  <!-- Final scroll transition -->
  <div
    class="hero__scroll-transition"
    aria-hidden="true"
  ></div>


  <!-- Hero content -->
  <div class="hero__content">

    <div class="hero__statement">
      <h1>Moche</h1>

      <p>
        Peruvian Cuisine &amp; Pisco Bar
      </p>
    </div>


    <a
      class="hero__cta"
      href="/booking"
    >
      <span>Book a table</span>

      <span aria-hidden="true">
        →
      </span>
    </a>

  </div>


  <!-- Scroll indicator -->
  <div
    class="hero__scroll"
    aria-hidden="true"
  >
    <span>Scroll</span>

    <span class="hero__scroll-line"></span>
  </div>

</section>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);


  /* =========================================
     IMAGE SLIDESHOW
  ========================================= */

  const images = Array.from(
    document.querySelectorAll<HTMLImageElement>(
      ".hero__image"
    )
  );

  let currentIndex = 0;

  const changeSlide = () => {
    if (images.length < 2) return;

    images[currentIndex].classList.remove(
      "is-active"
    );

    currentIndex =
      (currentIndex + 1) % images.length;

    images[currentIndex].classList.add(
      "is-active"
    );
  };

  window.setInterval(
    changeSlide,
    5000
  );


  /* =========================================
     HERO → BLACK TRANSITION
  ========================================= */

  const hero =
    document.querySelector(".hero");

  const transition =
    document.querySelector(
      ".hero__scroll-transition"
    );

  const content =
    document.querySelector(
      ".hero__content"
    );

  const scrollIndicator =
    document.querySelector(
      ".hero__scroll"
    );


  const reduceMotion =
    window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;


  if (
    hero &&
    transition &&
    content &&
    scrollIndicator &&
    !reduceMotion
  ) {

    /*
     * The hero stays visually unchanged
     * during the majority of its height.
     *
     * The black transition only begins when
     * the bottom of the hero approaches the
     * viewport.
     */

    gsap.fromTo(
      transition,
      {
        opacity: 0,
      },
      {
        opacity: 1,

        ease: "none",

        scrollTrigger: {
          trigger: hero,

          start: "bottom 85%",

          end: "bottom top",

          scrub: 1.5,

          invalidateOnRefresh: true,
        },
      }
    );


    /*
     * Hero content leaves progressively
     * during the final part of the hero.
     */

    gsap.to(
      content,
      {
        opacity: 0,

        y: -25,

        ease: "none",

        scrollTrigger: {
          trigger: hero,

          start: "bottom 70%",

          end: "bottom 25%",

          scrub: 1,

          invalidateOnRefresh: true,
        },
      }
    );


    /*
     * Scroll indicator disappears slightly
     * before the hero reaches its end.
     */

    gsap.to(
      scrollIndicator,
      {
        opacity: 0,

        ease: "none",

        scrollTrigger: {
          trigger: hero,

          start: "bottom 75%",

          end: "bottom 45%",

          scrub: 1,

          invalidateOnRefresh: true,
        },
      }
    );
  }
</script>


<style>

  /* =========================================
     HERO
  ========================================= */

  .hero {
    position: relative;

    min-height: 100svh;

    overflow: hidden;

    background: var(--color-dark);

    color: var(--color-white);
  }


  /* =========================================
     IMAGE CONTAINER
  ========================================= */

  .hero__images {
    position: absolute;

    inset: 0;
  }


  /* =========================================
     HERO IMAGES
  ========================================= */

  .hero__image {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center;

    opacity: 0;

    transform: scale(1.02);

    transition:
      opacity 1.2s ease,
      transform 7s ease;
  }


  .hero__image.is-active {
    opacity: 1;

    transform: scale(1);
  }


  /* =========================================
     PERMANENT IMAGE OVERLAY
  ========================================= */

  .hero__overlay {
    position: absolute;

    inset: 0;

    z-index: 1;

    background:
      linear-gradient(
        to bottom,

        rgba(0, 0, 0, 0.34) 0%,

        rgba(0, 0, 0, 0.05) 35%,

        rgba(0, 0, 0, 0.08) 55%,

        rgba(0, 0, 0, 0.58) 100%
      );

    pointer-events: none;
  }


  /* =========================================
     FINAL BLACK TRANSITION
  ========================================= */

  .hero__scroll-transition {
    position: absolute;

    inset: 0;

    z-index: 2;

    opacity: 0;

    background:
      linear-gradient(
        to bottom,

        rgba(0, 0, 0, 0) 0%,

        rgba(0, 0, 0, 0.02) 50%,

        rgba(0, 0, 0, 0.35) 75%,

        rgba(0, 0, 0, 1) 100%
      );

    pointer-events: none;

    will-change: opacity;
  }


  /* =========================================
     HERO CONTENT
  ========================================= */

  .hero__content {
    position: relative;

    z-index: 3;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    min-height: 100svh;

    padding:
      6rem
      var(--mobile-gutter)
      4rem;

    text-align: center;

    will-change:
      transform,
      opacity;
  }


  /* =========================================
     HERO STATEMENT
  ========================================= */

  .hero__statement {
    display: flex;

    flex-direction: column;

    align-items: center;

    margin-bottom: 2rem;
  }


  .hero__statement h1 {
    margin: 0;

    font-size:
      clamp(
        4.5rem,
        22vw,
        7rem
      );

    font-weight: 700;

    line-height: 0.8;

    letter-spacing: -0.07em;

    text-transform: uppercase;
  }


  .hero__statement p {
    max-width: 18rem;

    margin: 1.5rem 0 0;

    font-size: 0.8rem;

    line-height: 1.5;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }


  /* =========================================
     CTA
  ========================================= */

  .hero__cta {
    display: inline-flex;

    align-items: center;

    justify-content: space-between;

    width: 100%;

    min-height: 56px;

    padding: 0 1.25rem;

    border:
      1px solid
      rgba(255, 255, 255, 0.7);

    color: var(--color-white);

    font-size: 0.8rem;

    font-weight: 600;

    letter-spacing: 0.1em;

    text-transform: uppercase;

    backdrop-filter: blur(4px);

    transition:
      background-color 200ms ease,
      color 200ms ease;
  }


  .hero__cta span:last-child {
    font-size: 1.2rem;

    line-height: 1;
  }


  .hero__cta:hover,
  .hero__cta:focus-visible {
    background:
      var(--color-white);

    color:
      var(--color-dark);
  }


  /* =========================================
     SCROLL INDICATOR
  ========================================= */

  .hero__scroll {
    position: absolute;

    right: var(--mobile-gutter);

    bottom: 2rem;

    z-index: 4;

    display: none;

    will-change: opacity;
  }


  .hero__scroll-line {
    display: block;

    width: 1px;

    height: 2.5rem;

    margin-top: 0.5rem;

    background: currentColor;
  }


  /* =========================================
     DESKTOP
  ========================================= */

  @media (min-width: 768px) {

    .hero__content {
      padding:
        8rem
        3rem
        3rem;
    }


    .hero__statement h1 {
      font-size:
        clamp(
          7rem,
          18vw,
          13rem
        );
    }


    .hero__statement p {
      font-size: 0.9rem;
    }


    .hero__cta {
      width: fit-content;

      min-width: 220px;

      gap: 3rem;
    }


    .hero__scroll {
      display: block;

      font-size: 0.65rem;

      letter-spacing: 0.12em;

      text-transform: uppercase;
    }
  }


  /* =========================================
     REDUCED MOTION
  ========================================= */

  @media (prefers-reduced-motion: reduce) {

    .hero__image {
      transition:
        opacity 300ms ease;

      transform: none;
    }


    .hero__image.is-active {
      transform: none;
    }


    .hero__scroll-transition {
      opacity: 0;
    }
  }

</style>