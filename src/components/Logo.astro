---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<a href="/" class:list={["logo", className]} aria-label="Moche home">
  Moche
</a>

<style>
  .logo {
  display: inline-block;
  color: var(--color-white);
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.04em;
}
</style>