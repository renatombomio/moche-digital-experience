---
const backgroundImages = [
  "/images/pisco-staff/bar-team.jpg",
  "/images/pisco-staff/bartender.jpg",
  "/images/pisco-staff/cocktail-service.jpg",
];

const drinks = [
  {
    image: "/images/pisco/01-pisco-sour.jpg",
    alt: "Pisco Sour",
    name: "Pisco Sour",
    description:
      "Pisco, fresh lime, sugar, egg white and aromatic bitters.",
    details:
      "A Peruvian classic balancing pisco, fresh lime and sweetness, finished with a silky foam and aromatic bitters.",
    ingredients: [
      "Pisco",
      "Fresh lime",
      "Sugar",
      "Egg white",
      "Aromatic bitters",
    ],
    allergens: ["Egg"],
  },
  {
    image: "/images/pisco/02-passion-fruit-pisco-sour.jpg",
    alt: "Passion Fruit Pisco Sour",
    name: "Passion Fruit Pisco Sour",
    description:
      "Pisco, passion fruit, fresh lime, sugar and silky foam.",
    details:
      "A vibrant interpretation of the classic Pisco Sour, bringing tropical passion fruit into the balance of pisco and fresh lime.",
    ingredients: [
      "Pisco",
      "Passion fruit",
      "Fresh lime",
      "Sugar",
      "Egg white",
    ],
    allergens: ["Egg"],
  },
  {
    image: "/images/pisco/03-negroni-cusco.jpg",
    alt: "Negroni Cusco",
    name: "Negroni Cusco",
    description:
      "Pisco, bitter aperitif and vermouth with a Peruvian touch.",
    details:
      "A Peruvian interpretation of the Negroni, built around pisco and bitter, aromatic flavours.",
    ingredients: [
      "Pisco",
      "Bitter aperitif",
      "Vermouth",
      "Citrus",
    ],
    allergens: [],
  },
  {
    image: "/images/pisco/04-moche-espresso-martini.jpg",
    alt: "Moche Espresso Martini",
    name: "Moche Espresso Martini",
    description:
      "Pisco, espresso and coffee flavours with a Moche twist.",
    details:
      "A rich and aromatic cocktail combining pisco with espresso and deep coffee notes.",
    ingredients: [
      "Pisco",
      "Espresso",
      "Coffee",
      "Sugar",
    ],
    allergens: [],
  },
];
---

<section
  class="pisco-experience"
  aria-label="Moche pisco experience"
>

  <!-- =========================================
       BACKGROUND
  ========================================= -->

  <div
    class="pisco-experience__background"
    aria-hidden="true"
  >

    {backgroundImages.map((src, index) => (
      <img
        class:list={[
          "pisco-experience__background-image",
          { "is-active": index === 0 },
        ]}
        src={src}
        alt=""
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
      />
    ))}

  </div>


  <!-- =========================================
       BURGUNDY COLOUR TREATMENT
  ========================================= -->

  <div
    class="pisco-experience__colour"
    aria-hidden="true"
  ></div>


  <!-- =========================================
       DARK ATMOSPHERIC OVERLAY
  ========================================= -->

  <div
    class="pisco-experience__overlay"
    aria-hidden="true"
  ></div>


  <!-- =========================================
       INTRO / TRANSITION
  ========================================= -->

  <div class="pisco-experience__intro">

    <div class="pisco-experience__intro-stage">


      <!-- =====================================
           INITIAL MESSAGE
      ===================================== -->

      <div
        class="
          pisco-experience__message
          pisco-experience__message--from
        "
      >

        <span class="pisco-experience__eyebrow">
          Moche
        </span>

        <h2>
          Let's Make<br />
          It Wild
        </h2>

      </div>


      <!-- =====================================
           SVG MOTIF
      ===================================== -->

      <div
        class="pisco-experience__motif"
        aria-hidden="true"
      >

        <svg
          viewBox="0 0 300 300"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >

          <path
            class="pisco-motif-line"
            d="M150 18 L282 94 L282 206 L150 282 L18 206 L18 94 Z"
          />

          <path
            class="pisco-motif-line"
            d="M150 58 L242 111 L242 189 L150 242 L58 189 L58 111 Z"
          />

          <path
            class="pisco-motif-line"
            d="M150 92 L208 126 L208 174 L150 208 L92 174 L92 126 Z"
          />

          <path
            class="pisco-motif-line"
            d="M150 18 L150 92 M150 208 L150 282"
          />

          <path
            class="pisco-motif-line"
            d="M18 150 L92 150 M208 150 L282 150"
          />

          <path
            class="pisco-motif-line pisco-motif-line--accent"
            d="M150 128 L172 150 L150 172 L128 150 Z"
          />

        </svg>

      </div>


      <!-- =====================================
           FINAL MESSAGE
      ===================================== -->

      <div
        class="
          pisco-experience__message
          pisco-experience__message--modern
        "
      >

        <span class="pisco-experience__eyebrow">
          Moche
        </span>

        <h2>
          Pisco<br />
          Experience
        </h2>

      </div>

    </div>

  </div>


  <!-- =========================================
       DRINK CAROUSEL
  ========================================= -->

  <div class="pisco-experience__menu">

    <div
      class="pisco-carousel"
      aria-label="Moche signature cocktails"
    >

      <div class="pisco-carousel__track">

        {drinks.map((drink, index) => (

          <article
            class:list={[
              "pisco-card",
              { "is-current": index === 0 },
            ]}
            data-drink={index}
          >

            <button
              class="pisco-card__button"
              type="button"
              aria-label={`View details for ${drink.name}`}
            >

              <div class="pisco-card__image">

                <img
                  src={drink.image}
                  alt={drink.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />

              </div>


              <div class="pisco-card__content">

                <span class="pisco-card__eyebrow">
                  Moche
                </span>

                <h2>
                  {drink.name}
                </h2>

                <p>
                  {drink.description}
                </p>

                <span class="pisco-card__discover">
                  Discover drink
                  <span aria-hidden="true">↗</span>
                </span>

              </div>

            </button>

          </article>

        ))}

      </div>

    </div>


    <!-- =========================================
         PROGRESS
    ========================================= -->

    <div class="pisco-experience__progress">
      <span></span>
    </div>


    <!-- =========================================
         DRINKS MENU
    ========================================= -->

    <div class="pisco-experience__full-menu">

      <p>
        Want to explore more?
      </p>

      <a
        class="pisco-experience__menu-button"
        href="/drinks"
      >

        <span>
          View drinks menu
        </span>

        <span aria-hidden="true">
          →
        </span>

      </a>

    </div>

  </div>


  <!-- =========================================
       MODAL
  ========================================= -->

  <div
    class="pisco-modal"
    aria-hidden="true"
  >

    <div
      class="pisco-modal__backdrop"
      data-pisco-modal-close
    ></div>


    <div
      class="pisco-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pisco-modal-title"
    >

      <button
        class="pisco-modal__close"
        type="button"
        aria-label="Close drink details"
        data-pisco-modal-close
      >
        ×
      </button>


      <div class="pisco-modal__image">

        <img
          src=""
          alt=""
          data-pisco-modal-image
        />

      </div>


      <div class="pisco-modal__content">

        <span class="pisco-modal__eyebrow">
          Moche
        </span>

        <h2 id="pisco-modal-title"></h2>

        <p
          class="pisco-modal__description"
        ></p>


        <div class="pisco-modal__section">

          <h3>
            Ingredients
          </h3>

          <ul></ul>

        </div>


        <div class="pisco-modal__section">

          <h3>
            Allergens
          </h3>

          <p>
            Allergen information available on request.
          </p>

        </div>

      </div>

    </div>

  </div>

</section>


<script>

  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);


  /* =========================================
     SECTION
  ========================================= */

  const section =
    document.querySelector(
      ".pisco-experience"
    );


  if (!section) {

    throw new Error(
      "PiscoExperience: section not found."
    );

  }


  /* =========================================
     INTRO ELEMENTS
  ========================================= */

  const intro =
    section.querySelector<HTMLElement>(
      ".pisco-experience__intro"
    );


  const fromMessage =
    section.querySelector<HTMLElement>(
      ".pisco-experience__message--from"
    );


  const modernMessage =
    section.querySelector<HTMLElement>(
      ".pisco-experience__message--modern"
    );


  const motif =
    section.querySelector<HTMLElement>(
      ".pisco-experience__motif"
    );


  const motifLines =
    Array.from(
      section.querySelectorAll<SVGPathElement>(
        ".pisco-motif-line"
      )
    );


  /* =========================================
     BACKGROUND
  ========================================= */

  const backgroundImages =
    Array.from(
      section.querySelectorAll<HTMLImageElement>(
        ".pisco-experience__background-image"
      )
    );


  const track =
    section.querySelector<HTMLElement>(
      ".pisco-carousel__track"
    );


  const cards =
    Array.from(
      section.querySelectorAll<HTMLElement>(
        ".pisco-card"
      )
    );


  const progress =
    section.querySelector<HTMLElement>(
      ".pisco-experience__progress span"
    );


  const modal =
    section.querySelector<HTMLElement>(
      ".pisco-modal"
    );


  const modalImage =
    section.querySelector<HTMLImageElement>(
      "[data-pisco-modal-image]"
    );


  const modalTitle =
    section.querySelector(
      "#pisco-modal-title"
    );


  const modalDescription =
    section.querySelector(
      ".pisco-modal__description"
    );


  const modalIngredients =
    section.querySelector(
      ".pisco-modal__section ul"
    );


  const modalAllergens =
    section.querySelector(
      ".pisco-modal__section:last-child p"
    );


  const closeButtons =
    section.querySelectorAll(
      "[data-pisco-modal-close]"
    );


  const reduceMotion =
    window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;


  /* =========================================
     BACKGROUND ROTATION
  ========================================= */

  let backgroundIndex = 0;


  const changeBackground = () => {

    if (
      backgroundImages.length < 2
    ) {
      return;
    }


    backgroundImages[
      backgroundIndex
    ].classList.remove(
      "is-active"
    );


    backgroundIndex =
      (
        backgroundIndex + 1
      ) %
      backgroundImages.length;


    backgroundImages[
      backgroundIndex
    ].classList.add(
      "is-active"
    );

  };


  window.setInterval(
    changeBackground,
    6500
  );


  /* =========================================
     PISCO INTRO TRANSITION
  ========================================= */

  if (
    intro &&
    fromMessage &&
    modernMessage &&
    motif &&
    motifLines.length &&
    !reduceMotion
  ) {


    /* =====================================
       PREPARE SVG PATHS
    ===================================== */

    motifLines.forEach(
      (path) => {

        const length =
          path.getTotalLength();


        gsap.set(
          path,
          {

            strokeDasharray:
              length,

            strokeDashoffset:
              length,

          }
        );

      }
    );


    /* =====================================
       INITIAL STATE
    ===================================== */

    gsap.set(
      motif,
      {

        opacity: 1,

        scale: 0.88,

      }
    );


    gsap.set(
      modernMessage,
      {

        opacity: 0,

        y: 35,

      }
    );


    /* =====================================
       TIMELINE
    ===================================== */

    const introTimeline =
      gsap.timeline({

        scrollTrigger: {

          trigger:
            intro,

          start:
            "top 85%",

          end:
            "bottom 35%",

          scrub:
            1.4,

          invalidateOnRefresh:
            true,

        },

      });


    /* =====================================
       DRAW SVG
    ===================================== */

    introTimeline.to(
      motifLines,
      {

        strokeDashoffset:
          0,

        duration:
          0.7,

        stagger:
          0.08,

        ease:
          "power2.out",

      }
    );


    /* =====================================
       REMOVE INITIAL MESSAGE
    ===================================== */

    introTimeline.to(
      fromMessage,
      {

        opacity:
          0,

        y:
          -45,

        duration:
          0.25,

        ease:
          "power2.inOut",

      }
    );


    /* =====================================
       SVG MOVEMENT
    ===================================== */

    introTimeline.to(
      motif,
      {

        scale:
          1.08,

        rotation:
          2,

        duration:
          0.2,

        ease:
          "power2.inOut",

      },
      "<"
    );


    /* =====================================
       PISCO EXPERIENCE
    ===================================== */

    introTimeline.to(
      modernMessage,
      {

        opacity:
          1,

        y:
          0,

        duration:
          0.3,

        ease:
          "power2.out",

      }
    );


    /* =====================================
       FINAL SVG SETTLE
    ===================================== */

    introTimeline.to(
      motif,
      {

        scale:
          0.88,

        rotation:
          -2,

        opacity:
          0.42,

        duration:
          0.25,

        ease:
          "power2.inOut",

      },
      "<"
    );

  }


  /* =========================================
     CAROUSEL
  ========================================= */

  let currentCard = 0;

  let scrollTimeout:
    number | undefined;


  const updateProgress = () => {

    if (!progress) {
      return;
    }


    const percentage =
      cards.length <= 1
        ? 100
        : (
            currentCard /
            (cards.length - 1)
          ) *
          100;


    gsap.to(
      progress,
      {

        width:
          `${percentage}%`,

        duration:
          0.35,

        ease:
          "power2.out",

      }
    );

  };


  const animateCards = () => {

    if (!track) {
      return;
    }


    const center =
      track.scrollLeft +
      track.clientWidth / 2;


    cards.forEach(
      (card) => {

        const cardCenter =
          card.offsetLeft +
          card.offsetWidth / 2;


        const distance =
          cardCenter -
          center;


        const normalized =
          Math.max(
            -1,
            Math.min(
              1,
              distance /
                track.clientWidth
            )
          );


        const abs =
          Math.abs(
            normalized
          );


        const image =
          card.querySelector<HTMLImageElement>(
            ".pisco-card__image img"
          );


        const content =
          card.querySelector<HTMLElement>(
            ".pisco-card__content"
          );


        gsap.set(
          card,
          {

            scale:
              1 -
              abs * 0.08,

            opacity:
              1 -
              abs * 0.35,

            rotationY:
              normalized * -3,

            transformOrigin:
              "center center",

          }
        );


        if (image) {

          gsap.set(
            image,
            {

              scale:
                1 +
                abs * 0.05,

              x:
                normalized * -20,

            }
          );

        }


        if (content) {

          gsap.set(
            content,
            {

              x:
                normalized * 14,

            }
          );

        }

      }
    );

  };


  const updateCurrentCard =
    () => {

      if (!track) {
        return;
      }


      const center =
        track.scrollLeft +
        track.clientWidth / 2;


      let closest = 0;

      let distance = Infinity;


      cards.forEach(
        (card, index) => {

          const cardCenter =
            card.offsetLeft +
            card.offsetWidth / 2;


          const difference =
            Math.abs(
              cardCenter -
              center
            );


          if (
            difference <
            distance
          ) {

            distance =
              difference;

            closest =
              index;

          }

        }
      );


      currentCard =
        closest;


      updateProgress();

    };


  const snapToCard = () => {

    if (
      !track ||
      !cards[currentCard]
    ) {
      return;
    }


    const card =
      cards[currentCard];


    const target =
      card.offsetLeft -
      (
        track.clientWidth -
        card.offsetWidth
      ) /
        2;


    if (reduceMotion) {

      track.scrollLeft =
        target;

      return;

    }


    gsap.to(
      track,
      {

        scrollLeft:
          target,

        duration:
          0.65,

        ease:
          "power3.out",

        onUpdate:
          animateCards,

      }
    );

  };


  track?.addEventListener(
    "scroll",
    () => {

      animateCards();

      updateCurrentCard();


      window.clearTimeout(
        scrollTimeout
      );


      scrollTimeout =
        window.setTimeout(
          snapToCard,
          120
        );

    },
    {
      passive: true,
    }
  );


  /* =========================================
     DESKTOP WHEEL
  ========================================= */

  track?.addEventListener(
    "wheel",
    (event) => {

      if (
        window.innerWidth < 768
      ) {
        return;
      }


      if (
        Math.abs(
          event.deltaY
        ) <=
        Math.abs(
          event.deltaX
        )
      ) {
        return;
      }


      const maxScroll =
        track.scrollWidth -
        track.clientWidth;


      const atStart =
        track.scrollLeft <= 0;


      const atEnd =
        track.scrollLeft >=
        maxScroll - 1;


      if (
        (
          event.deltaY < 0 &&
          atStart
        ) ||
        (
          event.deltaY > 0 &&
          atEnd
        )
      ) {
        return;
      }


      event.preventDefault();


      track.scrollBy({

        left:
          event.deltaY * 1.25,

        behavior:
          "auto",

      });

    },
    {
      passive: false,
    }
  );


  /* =========================================
     INITIAL STATE
  ========================================= */

  requestAnimationFrame(
    () => {

      animateCards();

      updateProgress();

    }
  );


  /* =========================================
     MODAL
  ========================================= */

  const openModal =
    (index: number) => {

      const drink =
        drinks[index];


      if (
        !drink ||
        !modal ||
        !modalImage ||
        !modalTitle ||
        !modalDescription ||
        !modalIngredients ||
        !modalAllergens
      ) {
        return;
      }


      modalImage.src =
        drink.image;


      modalImage.alt =
        drink.alt;


      modalTitle.textContent =
        drink.name;


      modalDescription.textContent =
        drink.details;


      modalIngredients.innerHTML =
        drink.ingredients
          .map(
            (ingredient) =>
              `<li>${ingredient}</li>`
          )
          .join("");


      modalAllergens.textContent =
        drink.allergens.length
          ? drink.allergens.join(", ")
          : "Allergen information available on request.";


      modal.classList.add(
        "is-open"
      );


      modal.setAttribute(
        "aria-hidden",
        "false"
      );


      document.body.classList.add(
        "modal-open"
      );


      if (!reduceMotion) {

        gsap.fromTo(
          ".pisco-modal__dialog",
          {

            opacity:
              0,

            y:
              35,

            scale:
              0.97,

          },
          {

            opacity:
              1,

            y:
              0,

            scale:
              1,

            duration:
              0.45,

            ease:
              "power3.out",

          }
        );

      }

    };


  const closeModal =
    () => {

      if (!modal) {
        return;
      }


      if (reduceMotion) {

        modal.classList.remove(
          "is-open"
        );


        modal.setAttribute(
          "aria-hidden",
          "true"
        );


        document.body.classList.remove(
          "modal-open"
        );


        return;

      }


      gsap.to(
        ".pisco-modal__dialog",
        {

          opacity:
            0,

          y:
            25,

          scale:
            0.98,

          duration:
            0.2,

          ease:
            "power2.in",

          onComplete:
            () => {

              modal.classList.remove(
                "is-open"
              );


              modal.setAttribute(
                "aria-hidden",
                "true"
              );


              document.body.classList.remove(
                "modal-open"
              );

            },

        }
      );

    };


  cards.forEach(
    (card, index) => {

      const button =
        card.querySelector(
          ".pisco-card__button"
        );


      button?.addEventListener(
        "click",
        () => {

          openModal(
            index
          );

        }
      );

    }
  );


  closeButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        closeModal
      );

    }
  );


  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key === "Escape"
      ) {

        closeModal();

      }

    }
  );

</script>


<style>

/* =========================================
   PISCO EXPERIENCE
========================================= */

.pisco-experience {

  --pisco-red:
    #551b1b;

  --pisco-red-dark:
    #24090b;

  --pisco-gold:
    #c49a4d;

  --pisco-cream:
    #f5f2ea;

  position:
    relative;

  overflow:
    hidden;

  background:
    var(--pisco-red-dark);

  color:
    var(--pisco-cream);

  isolation:
    isolate;
}


/* =========================================
   BACKGROUND PHOTOGRAPHY
========================================= */

.pisco-experience__background {

  position:
    absolute;

  inset:
    -7%;

  z-index:
    0;

  overflow:
    hidden;

  opacity:
    0.78;

  transform:
    scale(1.04);

  filter:
    blur(7px)
    saturate(0.78)
    contrast(0.9);
}


.pisco-experience__background-image {

  position:
    absolute;

  inset:
    0;

  width:
    100%;

  height:
    100%;

  object-fit:
    cover;

  opacity:
    0;

  transform:
    scale(1.04);

  transition:
    opacity 1.8s ease,
    transform 7s ease;
}


.pisco-experience__background-image.is-active {

  opacity:
    1;

  transform:
    scale(1);
}


/* =========================================
   BURGUNDY COLOUR TREATMENT
========================================= */

.pisco-experience__colour {

  position:
    absolute;

  inset:
    0;

  z-index:
    1;

  background:
    linear-gradient(
      120deg,
      rgba(
        42,
        7,
        10,
        0.68
      ) 0%,

      rgba(
        103,
        27,
        34,
        0.48
      ) 42%,

      rgba(
        76,
        16,
        22,
        0.62
      ) 72%,

      rgba(
        28,
        5,
        8,
        0.76
      ) 100%
    );

  mix-blend-mode:
    multiply;

  pointer-events:
    none;
}


/* =========================================
   ATMOSPHERIC DARKENING
========================================= */

.pisco-experience__overlay {

  position:
    absolute;

  inset:
    0;

  z-index:
    2;

  background:
    linear-gradient(
      to bottom,
      rgba(
        15,
        3,
        4,
        0.38
      ) 0%,

      rgba(
        15,
        3,
