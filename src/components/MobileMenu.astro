@media (prefers-reduced-motion: reduce) {
  .mobile-menu, .mobile-menu__main-link, .mobile-menu__food-icon, .mobile-menu__submenu, .mobile-menu__submenu a, :global(.menu-button), :global(.menu-button span) { transition: none; }
}
</style>