    scaleX(1);

  background:
    #c49a4d;

}


.mobile-menu__main-link--booking:hover
.mobile-menu__link-label {

  color:
    #c49a4d;

}


/* =========================================================
   FOOD ICON
========================================================= */

.mobile-menu__food-icon {

  position:
    relative;

  flex:
    0 0 auto;

  width:
    2.3rem;

  height:
