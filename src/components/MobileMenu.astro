<nav
  id="mobile-menu"
  class="mobile-menu"
  aria-hidden="true"
>

  <!-- =========================================
       GEOMETRIC BACKGROUND
  ========================================= -->

  <div
    class="mobile-menu__geometry"
    aria-hidden="true"
  >

    <svg
      viewBox="0 0 600 600"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >

      <path
        class="mobile-menu__geometry-line"
        d="M300 40 L540 180 L540 420 L300 560 L60 420 L60 180 Z"
      />

      <path
        class="mobile-menu__geometry-line"
        d="M300 105 L485 212 L485 388 L300 495 L115 388 L115 212 Z"
      />

      <path
        class="mobile-menu__geometry-line"
        d="M300 165 L430 240 L430 360 L300 435 L170 360 L170 240 Z"
      />

      <path
        class="mobile-menu__geometry-line"
        d="M300 40 L300 165"
      />

      <path
        class="mobile-menu__geometry-line"
        d="M300 435 L300 560"
      />

      <path
        class="mobile-menu__geometry-line"
        d="M60 300 L170 300"
      />

      <path
        class="mobile-menu__geometry-line"
        d="M430 300 L540 300"
      />

      <path
        class="mobile-menu__geometry-line mobile-menu__geometry-line--accent"
        d="M300 275 L325 300 L300 325 L275 300 Z"
      />

    </svg>

  </div>


  <!-- =========================================
       INNER
  ========================================= -->

  <div class="mobile-menu__inner">

    <!-- HEADER -->

    <header class="mobile-menu__header">

      <span class="mobile-menu__brand">
        Moche
      </span>

    </header>


    <!-- CONTENT -->

    <div class="mobile-menu__content">

      <!-- INTRO -->

      <div class="mobile-menu__intro">

        <span>
          Moche
        </span>

        <p>
          The experience
        </p>

      </div>


      <!-- NAVIGATION -->

      <ul class="mobile-menu__links">

        <!-- =======================================
             FOOD
        ======================================== -->

        <li
          class="mobile-menu__item mobile-menu__item--food"
        >

          <button
            class="mobile-menu__food-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="food-submenu"
          >

            <span class="mobile-menu__link-label">
              Food
            </span>

            <span
              class="mobile-menu__food-icon"
              aria-hidden="true"
            ></span>

          </button>


          <!-- FOOD SUBMENU -->

          <ul
            id="food-submenu"
            class="mobile-menu__submenu"
            aria-hidden="true"
          >

            <li>

              <a href="/menu/lunch">

                <span>
                  Lunch
                </span>

                <span aria-hidden="true">
                  ↗
                </span>

              </a>

            </li>


            <li>

              <a href="/menu/dinner">

                <span>
                  Dinner
                </span>

                <span aria-hidden="true">
                  ↗
                </span>

              </a>

            </li>

          </ul>

        </li>


        <!-- =======================================
             DRINKS
        ======================================== -->

        <li class="mobile-menu__item">

          <a
            href="/drinks"
            class="mobile-menu__main-link"
          >

            <span class="mobile-menu__link-label">
              Drinks
            </span>

            <span
              class="mobile-menu__arrow"
              aria-hidden="true"
            >
              ↗
            </span>

          </a>

        </li>


        <!-- =======================================
             ABOUT US
        ======================================== -->

        <li class="mobile-menu__item">

          <a
            href="/about"
            class="mobile-menu__main-link"
          >

            <span class="mobile-menu__link-label">
              About Us
            </span>

            <span
              class="mobile-menu__arrow"
              aria-hidden="true"
            >
              ↗
            </span>

          </a>

        </li>


        <!-- =======================================
             CONTACT
        ======================================== -->

        <li class="mobile-menu__item">

          <a
            href="/contact"
            class="mobile-menu__main-link"
          >

            <span class="mobile-menu__link-label">
              Contact
            </span>

            <span
              class="mobile-menu__arrow"
              aria-hidden="true"
            >
              ↗
            </span>

          </a>

        </li>


        <!-- =======================================
             BOOK A TABLE
        ======================================== -->

        <li
          class="mobile-menu__item mobile-menu__item--booking"
        >

          <a
            href="/booking"
            class="mobile-menu__main-link mobile-menu__main-link--booking"
          >

            <span class="mobile-menu__link-label">
              Book a Table
            </span>

            <span
              class="mobile-menu__arrow"
              aria-hidden="true"
            >
              →
            </span>

          </a>

        </li>

      </ul>

    </div>


    <!-- =========================================
         FOOTER
    ========================================= -->

    <footer class="mobile-menu__footer">

      <div
        class="mobile-menu__divider"
        aria-hidden="true"
      >

        <span></span>

        <span class="mobile-menu__symbol">
          ◇
        </span>

        <span></span>

      </div>


      <div class="mobile-menu__footer-info">

        <a
          href="https://www.instagram.com/moche_amsterdam/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram ↗
        </a>

        <span>
          Amsterdam
        </span>

      </div>

    </footer>

  </div>

</nav>


<script>
  import { gsap } from "gsap";


  /* =========================================================
     ELEMENTS
  ========================================================= */

  const menu =
    document.querySelector<HTMLElement>(
      "#mobile-menu"
    );


  const openButton =
    document.querySelector<HTMLButtonElement>(
      ".menu-button"
    );


  const foodToggle =
    menu?.querySelector<HTMLButtonElement>(
      ".mobile-menu__food-toggle"
    );


  const foodSubmenu =
    menu?.querySelector<HTMLElement>(
      ".mobile-menu__submenu"
    );


  const geometry =
    menu?.querySelector<HTMLElement>(
      ".mobile-menu__geometry"
    );


  const geometryLines =
    menu?.querySelectorAll<SVGPathElement>(
      ".mobile-menu__geometry-line"
    );


  const intro =
    menu?.querySelector<HTMLElement>(
      ".mobile-menu__intro"
    );


  const menuItems =
    menu?.querySelectorAll<HTMLElement>(
      ".mobile-menu__item"
    );


  const footer =
    menu?.querySelector<HTMLElement>(
      ".mobile-menu__footer"
    );


  /* =========================================================
     INITIAL GSAP STATE
  ========================================================= */

  if (
    geometry &&
    geometryLines &&
    intro &&
    menuItems &&
    footer
  ) {

    gsap.set(
      geometry,
      {
        opacity: 0,
        scale: 0.96,
        rotation: -2
      }
    );


    gsap.set(
      geometryLines,
      {
        strokeDasharray: 900,
        strokeDashoffset: 900
      }
    );


    gsap.set(
      intro,
      {
        opacity: 0,
        y: 18
      }
    );


    gsap.set(
      menuItems,
      {
        opacity: 0,
        y: 28
      }
    );


    gsap.set(
      footer,
      {
        opacity: 0,
        y: 12
      }
    );

  }


  /* =========================================================
     OPEN / CLOSE
  ========================================================= */

  if (
    menu &&
    openButton
  ) {

    const openMenu = () => {

      menu.setAttribute(
        "aria-hidden",
        "false"
      );


      openButton.setAttribute(
        "aria-expanded",
        "true"
      );


      openButton.classList.add(
        "is-open"
      );


      document.body.classList.add(
        "menu-open"
      );


      const timeline =
        gsap.timeline({
          defaults: {
            ease:
              "power3.out"
          }
        });


      timeline.to(
        menu,
        {
          visibility:
            "visible",

          opacity:
            1,

          y:
            0,

          duration:
            0.32
        }
      );


      timeline.to(
        geometry,
        {
          opacity:
            0.075,

          scale:
            1,

          rotation:
            0,

          duration:
            0.85
        },
        "-=0.12"
      );


      timeline.to(
        geometryLines,
        {
          strokeDashoffset:
            0,

          duration:
            1.05,

          stagger:
            0.035,

          ease:
            "power2.out"
        },
        "-=0.7"
      );


      timeline.to(
        intro,
        {
          opacity:
            1,

          y:
            0,

          duration:
            0.42
        },
        "-=0.72"
      );


      timeline.to(
        menuItems,
        {
          opacity:
            1,

          y:
            0,

          duration:
            0.48,

          stagger:
            0.065
        },
        "-=0.22"
      );


      timeline.to(
        footer,
        {
          opacity:
            1,

          y:
            0,

          duration:
            0.38
        },
        "-=0.25"
      );

    };


    const closeMenu = () => {

      const timeline =
        gsap.timeline({
          defaults: {
            ease:
              "power2.inOut"
          },

          onComplete: () => {

            menu.setAttribute(
              "aria-hidden",
              "true"
            );

          }
        });


      timeline.to(
        footer,
        {
          opacity:
            0,

          y:
            10,

          duration:
            0.16
        }
      );


      timeline.to(
        menuItems,
        {
          opacity:
            0,

          y:
            16,

          duration:
            0.2,

          stagger:
            0.02
        },
        "-=0.08"
      );


      timeline.to(
        intro,
        {
          opacity:
            0,

          y:
            10,

          duration:
            0.16
        },
        "-=0.1"
      );


      timeline.to(
        geometry,
        {
          opacity:
            0,

          scale:
            0.97,

          rotation:
            2,

          duration:
            0.28
        },
        "-=0.08"
      );


      timeline.to(
        menu,
        {
          opacity:
            0,

          y:
            -10,

          duration:
            0.28,

          onStart: () => {

            openButton.setAttribute(
              "aria-expanded",
              "false"
            );

            openButton.classList.remove(
              "is-open"
            );

            document.body.classList.remove(
              "menu-open"
            );

          }
        },
        "-=0.16"
      );


      if (
        foodToggle &&
        foodSubmenu
      ) {

        foodToggle.setAttribute(
          "aria-expanded",
          "false"
        );


        foodSubmenu.setAttribute(
          "aria-hidden",
          "true"
        );


        foodToggle.classList.remove(
          "is-open"
        );

      }

    };


    /* =========================================================
       MENU BUTTON
    ========================================================= */

    openButton.addEventListener(
      "click",
      () => {

        const isOpen =
          menu.getAttribute(
            "aria-hidden"
          ) === "false";


        if (isOpen) {

          closeMenu();

        } else {

          openMenu();

        }

      }
    );


    /* =========================================================
       FOOD
    ========================================================= */

    if (
      foodToggle &&
      foodSubmenu
    ) {

      foodToggle.addEventListener(
        "click",
        () => {

          const isOpen =
            foodToggle.getAttribute(
              "aria-expanded"
            ) === "true";


          foodToggle.setAttribute(
            "aria-expanded",
            String(!isOpen)
          );


          foodSubmenu.setAttribute(
            "aria-hidden",
            String(isOpen)
          );


          foodToggle.classList.toggle(
            "is-open",
            !isOpen
          );


          if (!isOpen) {

            gsap.fromTo(
              foodSubmenu.querySelectorAll(
                "li"
              ),
              {
                opacity:
                  0,

                y:
                  -10
              },
              {
                opacity:
                  1,

                y:
                  0,

                duration:
                  0.32,

                stagger:
                  0.06,

                ease:
                  "power3.out"
              }
            );

          }

        }
      );

    }


    /* =========================================================
       HOVER
    ========================================================= */

    menuItems?.forEach(
      (item) => {

        item.addEventListener(
          "mouseenter",
          () => {

            menuItems.forEach(
              (otherItem) => {

                if (
                  otherItem !== item
                ) {

                  gsap.to(
                    otherItem,
                    {
                      opacity:
                        0.38,

                      duration:
                        0.24,

                      ease:
                        "power2.out"
                    }
                  );

                }

              }
            );

          }
        );


        item.addEventListener(
          "mouseleave",
          () => {

            menuItems.forEach(
              (otherItem) => {

                gsap.to(
                  otherItem,
                  {
                    opacity:
                      1,

                    duration:
                      0.28,

                    ease:
                      "power2.out"
                  }
                );

              }
            );

          }
        );

      }
    );


    /* =========================================================
       CLOSE ON NAVIGATION
    ========================================================= */

    menu
      .querySelectorAll<HTMLAnchorElement>(
        "a"
      )
      .forEach(
        (link) => {

          link.addEventListener(
            "click",
            () => {

              closeMenu();

            }
          );

        }
      );


    /* =========================================================
       ESCAPE
    ========================================================= */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          menu.getAttribute(
            "aria-hidden"
          ) === "false"
        ) {

          closeMenu();

        }

      }
    );

  }

</script>


<style>

/* =========================================================
   MENU
========================================================= */

