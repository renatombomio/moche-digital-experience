---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import FoodExperience from "../components/FoodExperience.astro";
import PiscoExperience from "../components/PiscoExperience.astro";
import Reviews from "../components/Reviews.astro";
import AboutUs from "../components/AboutUs.astro";
import Contact from "../components/Contact.astro"
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Moche — Peruvian Cuisine & Pisco Bar in Amsterdam."
    />
    <meta name="theme-color" content="#171513" />
    <title>Moche — Peruvian Cuisine & Pisco Bar</title>
  </head>

  <body>
    <Header />

    <main id="main-content">
      <Hero />
      <FoodExperience />
      <PiscoExperience />
      <Reviews />
      <AboutUs />
    <Contact />
    </main>
  </body>
</html>